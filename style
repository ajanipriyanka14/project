.product-card {
    background: #111 !important;
    border: 2px solid #333 !important;
    border-radius: 15px !important;
    overflow: hidden;
    transition: all 0.3s ease !important;
}

.product-card:hover {
    border-color: #E88F2A !important;
    box-shadow: 0 0 20px rgba(232,143,42,0.7) !important;
    transform: translateY(-5px) !important;
}

.product-card img {
    width: 100% !important;
    height: 230px !important;
    object-fit: cover !important;
}

.product-card .card-body {
    background: #111 !important;
    color: #fff !important;
}

.product-card h5 {
    color: #fff !important;
}

.product-card p {
    color: #ccc !important;
}

.product-price {
    color: #E88F2A !important;
}

.view-product-btn {
    display: inline-block;
    padding: 11px 30px;
    background: #E88F2A;
    color: #fff !important;
    border: 2px solid #E88F2A;
    border-radius: 50px;
    text-decoration: none !important;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(232,143,42,0.25);
}

.view-product-btn:hover {
    background: #000;
    color: #E88F2A !important;
    border-color: #E88F2A;
    box-shadow: 0 0 18px rgba(232,143,42,0.7);
    transform: translateY(-2px);
}

.view-product-btn:active {
    transform: scale(0.96);
}
.product-rating {
    margin: 8px 0 12px;
    text-align: center;
}

.product-rating .star {
    color: #E88F2A;
    font-size: 18px;
    letter-spacing: 1px;
}

.product-rating .star.empty {
    color: #555;
}

.rating-number {
    color: #fff;
    font-weight: bold;
    margin-left: 6px;
}

.review-count {
    color: #aaa;
    font-size: 13px;
    margin-left: 3px;
}
